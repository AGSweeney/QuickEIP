$ EZ-EDS Version 3.x compatible
$ Sample EDS for the adapter in the README quick start and docs/INTEGRATION.md section 3.
$ Before shipping a product, set the [Device] values and the sizes and paths for your device:
$ the table in docs/INTEGRATION.md section 3.6 lists each one.
$ VendCode 65000 is a placeholder, not an assigned ODVA vendor id.

[File]
        DescText = "QuickEIP sample adapter";
        CreateDate = 11-04-2026;
        CreateTime = 12:00:00;
        ModDate = 11-04-2026;
        ModTime = 12:00:00;
        Revision = 1.0;

[Device]
        VendCode = 65000;
        VendName = "QuickEIP Sample";
        ProdType = 43;
        ProdTypeStr = "Generic Device";
        ProdCode = 1;
        MajRev = 1;
        MinRev = 1;
        ProdName = "My Device";
        Catalog = "My Device";

[Device Classification]
        Class1 = EtherNetIP;

[Params]
        Param1 =
                0,                      $ reserved
                ,,                      $ link path size, link path
                0x0000,                 $ descriptor
                0xC8,                   $ data type: UDINT
                4,                      $ data size in bytes
                "RPI",                  $ name
                "Microsecond",          $ units
                "Requested packet interval.", $ help
                10000,100000,20000,     $ min, max, default
                ,,,,                    $ scaling
                ,,,,                    $ links
                ;                       $ decimal places
        Param2 =
                0,                      $ reserved
                ,,                      $ link path size, link path
                0x0000,                 $ descriptor
                0xC6,                   $ data type: USINT
                1,                      $ data size in bytes
                "Config Data",          $ name
                "",                     $ units
                "Placeholder: the configuration assembly has no data.", $ help
                151,151,151,            $ min, max, default
                ,,,,                    $ scaling
                ,,,,                    $ links
                ;                       $ decimal places

[Assembly]
        Revision = 2;
        Object_Name = "Assembly Object";
        Object_Class_Code = 0x04;
        Number_Of_Static_Instances = 3;
        Assem100 =
                "Inputs",               $ device -> PLC (EIP_ASM_PRODUCED)
                "20 04 24 64 30 03",    $ path
                32,                     $ size in bytes
                0x0000,                 $ descriptor
                ,,                      $ reserved
                256,;                   $ member size in bits
        Assem150 =
                "Outputs",              $ PLC -> device (EIP_ASM_CONSUMED)
                "20 04 24 96 30 03",
                32,
                0x0001,
                ,,
                256,;
        Assem151 =
                "Config",               $ configuration, no data (EIP_ASM_CONFIG, size 0)
                "20 04 24 97 30 03",
                0,
                0x0000,
                ,,
                0,Param2;               $ no data: the member is a placeholder

[Connection Manager]
        Object_Name = "Connection Manager Object";
        Object_Class_Code = 0x06;
        Connection1 =
                0x04010002,             $ trigger and transport: class 1, cyclic, exclusive owner
                0x44640405,             $ O->T point-to-point, fixed, 32-bit run/idle header; T->O multicast or point-to-point, fixed, modeless
                Param1,32,Assem150,     $ O->T RPI, size, format (assembly bytes only)
                Param1,32,Assem100,     $ T->O RPI, size, format (assembly bytes only)
                ,,                      $ config part 1 (none)
                0,Param2,               $ config part 2: size, format
                "Exclusive Owner",      $ name
                "",                     $ help
                "20 04 24 97 2C 96 2C 64";  $ path: assembly class, config 151, consume 150, produce 100

[Port]
        Object_Name = "Port Object";
        Object_Class_Code = 0xF4;
        Port1 =
                TCP,                    $ port type
                "EtherNet/IP Port",     $ name
                "20 F5 24 01",          $ TCP/IP Interface object
                1,                      $ port number
                0x00,                   $ port routing capabilities: none
                ;

[Capacity]
        MaxIOConnections = 1;
        MaxMsgConnections = 2;
        TSpec1 = Rx, 32, 100;
        TSpec2 = Tx, 32, 100;

[TCP/IP Interface Class]
        Revision = 4;
        Object_Name = "TCP/IP Interface Object";
        Object_Class_Code = 0xF5;
        MaxInst = 1;
        Number_Of_Static_Instances = 1;
        Max_Number_Of_Dynamic_Instances = 0;

[Ethernet Link Class]
        Revision = 3;
        Object_Name = "Ethernet Link Object";
        Object_Class_Code = 0xF6;
        MaxInst = 3;
        Number_Of_Static_Instances = 3;
        Max_Number_Of_Dynamic_Instances = 0;

[Identity Class]
        Revision = 1;
        Object_Name = "Identity Object";
        Object_Class_Code = 0x01;
        MaxInst = 1;
        Number_Of_Static_Instances = 1;
        Max_Number_Of_Dynamic_Instances = 0;
